# -------------------------------
# GAUSSIAN FIT FUNCTIONS (yours)
# -------------------------------
def get_pixel_size_um(pixel_size_sensor, magnification):
    return pixel_size_sensor / magnification

def gaussian_1d(x, amp, x0, sigma, offset):
    # 1D Gaussian
    return offset + amp * np.exp(-((x - x0)**2) / (2 * sigma**2))

def sum_roi_along_axis(roi, axis=1):
    # Sums the ROI along the specified axis (0 for y, 1 for x)
    roi_sum = np.sum(roi, axis=axis)
    return roi_sum

def fit_gaussian_to_roi_sum(roi_sum):
    # Fits 1D Gaussian to the summed profile and returns FWHM
    x_size = roi_sum.shape[0]
    x = np.arange(x_size)
    initial_guess = (roi_sum.max(), x_size/2, x_size/4, roi_sum.min())  # sigma ~ x_size/4
    params, _ = curve_fit(gaussian_1d, x, roi_sum, p0=initial_guess, maxfev=10000)
    amp, x0, sigma, offset = params
    fwhm = 2.355 * sigma
    return fwhm, params

def plot_roi_sum_and_fit(roi_sum, params, title="ROI Sum and Gaussian Fit", x_label="Pixel"):
    x_size = roi_sum.shape[0]
    x = np.arange(x_size)
    fit_data = gaussian_1d(x, *params)

    plt.figure(figsize=(6, 4))
    plt.title(title)
    plt.plot(x, roi_sum, label='Profile', color='blue')
    plt.plot(x, fit_data, label='Gaussian Fit', color='red', linestyle='--')
    plt.xlabel(x_label)
    plt.ylabel('Summed Intensity')
    plt.legend()
    plt.tight_layout()
    plt.show()

def rayleigh_criterion(lambda_um, NA):
    return 0.61 * lambda_um / NA

def sparrow_limit(lambda_um, NA):
    return 0.47 * lambda_um / NA

def abbe_limit(lambda_um, NA):
    return 0.5 * lambda_um / NA

# -------------------------------
# NEW: Bead detection/averaging utilities
# -------------------------------
def detect_beads(img_roi, min_distance=5, threshold_rel=0.3):
    """
    Detect bright local maxima inside the cropped ROI.
    Returns coords in ROI coordinates as (row, col).
    """
    coords = feature.peak_local_max(
        img_roi,
        min_distance=min_distance,
        threshold_rel=threshold_rel
    )
    return coords

def extract_bead_rois(img_roi, coords, bead_roi_size=21):
    """
    Extract square ROIs of size bead_roi_size around each detected bead center.
    Returns list of small ROI arrays and a boolean mask for which were valid.
    """
    half = bead_roi_size // 2
    rois = []
    valid_coords = []
    H, W = img_roi.shape[:2]
    for (r, c) in coords:
        if (r > half and r < H - half - 1 and
            c > half and c < W - half - 1):
            roi = img_roi[r-half:r+half+1, c-half:c+half+1]
            # Filter out saturated or empty
            if np.isfinite(roi).all() and roi.max() > 0:
                rois.append(roi.astype(np.float32))
                valid_coords.append([r, c])
    return rois, np.array(valid_coords)

def normalize_and_align(rois, align_subpixel=True, norm_mode="max", upsample_factor=100):
    """
    Normalize each ROI, optionally align to the first ROI (subpixel).
    norm_mode: 'max' (default) or 'sum'
    Returns list of (aligned) ROIs (float32).
    """
    if len(rois) == 0:
        return []

    # Normalize
    normed = []
    for roi in rois:
        if norm_mode == "sum":
            s = roi.sum()
            normed.append(roi / s if s > 0 else roi.copy())
        else:  # 'max'
            m = roi.max()
            normed.append(roi / m if m > 0 else roi.copy())

    if not align_subpixel or len(normed) == 1:
        return normed

    ref = normed[0]
    aligned = []
    for roi in normed:
        shift_est, _, _ = registration.phase_cross_correlation(
            ref, roi, upsample_factor=upsample_factor
        )
        aligned.append(shift(roi, shift=shift_est, mode='nearest', order=1))
    return aligned

def average_psf(rois):
    """Compute pixel-wise average of a list of ROIs (float32)."""
    if len(rois) == 0:
        return None
    return np.mean(np.stack(rois, axis=0), axis=0)

def compute_fwhm_xy(psf_avg):
    """
    Compute FWHM in X and Y from the averaged PSF by summing to 1D
    and fitting a 1D Gaussian along each axis.
    Returns (fwhm_x_px, params_x, fwhm_y_px, params_y).
    """
    # Note: image shape is (rows=Y, cols=X)
    prof_x = psf_avg.sum(axis=0)  # profile over columns (X)
    prof_y = psf_avg.sum(axis=1)  # profile over rows (Y)

    fwhm_x_px, params_x = fit_gaussian_to_roi_sum(prof_x)
    fwhm_y_px, params_y = fit_gaussian_to_roi_sum(prof_y)
    return fwhm_x_px, params_x, fwhm_y_px, params_y

