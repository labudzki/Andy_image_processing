def process_selected_roi(roi_coords):
    """
    Called when an ROI rectangle is added. Crops, detects beads, averages their PSF,
    shows overlays and prints/saves results.
    """
    # Crop ROI from global coordinates of rectangle verts
    y_min, y_max = int(np.floor(np.min(roi_coords[:, 0]))), int(np.ceil(np.max(roi_coords[:, 0])))
    x_min, x_max = int(np.floor(np.min(roi_coords[:, 1]))), int(np.ceil(np.max(roi_coords[:, 1])))
    img_roi = img2d[y_min:y_max, x_min:x_max]

    # Show cropped ROI as a new image layer (so you can inspect)
    viewer.add_image(img_roi, name=f'Cropped ROI [{y_min}:{y_max},{x_min}:{x_max}]')
                     #,contrast_limits=[float(np.percentile(img_roi, 1)), float(np.percentile(img_roi, 99))])

    # Detect beads inside the ROI
    coords_roi = detect_beads(img_roi, min_distance=min_distance, threshold_rel=threshold_rel)
    print(f"Detected {len(coords_roi)} beads in selected ROI")

    if len(coords_roi) == 0:
        print("No beads found in this ROI. Try lowering threshold_rel or enlarging the ROI.")
        return

    # Draw bead centers in global coordinates on the points layer
    coords_global = coords_roi + np.array([y_min, x_min])  # (row, col) in global image
    if len(points_layer.data) == 0:
        points_layer.data = coords_global
    else:
        # Append (napari uses Nx2 array of row, col)
        points_layer.data = np.vstack([points_layer.data, coords_global])

    # Extract small bead ROIs inside the cropped region
    bead_rois, valid_coords = extract_bead_rois(img_roi, coords_roi, bead_roi_size=bead_roi_size)
    print(f"Extracted {len(bead_rois)} bead ROIs (size {bead_roi_size}x{bead_roi_size})")

    if len(bead_rois) == 0:
        print("No valid bead ROIs after boundary check.")
        return

    # Normalize and optionally align
    rois_ready = normalize_and_align(
        bead_rois, align_subpixel=align_subpixel,
        norm_mode=norm_mode, upsample_factor=upsample_factor
    )

    # Average to PSF
    psf_avg = average_psf(rois_ready)
    if psf_avg is None:
        print("Could not compute average PSF.")
        return

    # Add averaged PSF as a new image layer for visual inspection
    viewer.add_image(psf_avg, name='Averaged PSF',
                     #contrast_limits=[float(np.min(psf_avg)), float(np.max(psf_avg))],
                     colormap='inferno')

    # Compute FWHM in X and Y from the averaged PSF
    fwhm_x_px, params_x, fwhm_y_px, params_y = compute_fwhm_xy(psf_avg)
    fwhm_x_um = fwhm_x_px * pixel_size_um
    fwhm_y_um = fwhm_y_px * pixel_size_um

    print(f"Bead count used: {len(rois_ready)}")
    print(f"FWHM X: {fwhm_x_px:.2f} px ({fwhm_x_um:.3f} µm)")
    print(f"FWHM Y: {fwhm_y_px:.2f} px ({fwhm_y_um:.3f} µm)")
    print(f"Abbe limit: {abbe_limit_val:.3f} µm | Rayleigh: {theoretical_rayleigh_resolution:.3f} µm | Sparrow: {sparrow_limit(lambda_um, NA):.3f} µm")

    # Plot 1D profiles + fits for both axes
    prof_x = psf_avg.sum(axis=0)
    plot_roi_sum_and_fit(prof_x, params_x, title="Averaged PSF — X profile", x_label="X pixel")
    prof_y = psf_avg.sum(axis=1)
    plot_roi_sum_and_fit(prof_y, params_y, title="Averaged PSF — Y profile", x_label="Y pixel")

    # Save averaged PSF
    np.save("psf_average.npy", psf_avg)
    print("Saved averaged PSF to psf_average.npy")

# Connect to shapes layer event: when rectangles change, process the last one
@shapes_layer.events.data.connect
def on_roi_added(event):
    if len(shapes_layer.data) > 0:
        roi_coords = np.array(shapes_layer.data[-1])  # (4,2) rectangle vertices
        process_selected_roi(roi_coords)

